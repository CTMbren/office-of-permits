{
  "name": "office-of-permits",
  "version": "0.1.0",
  "private": true,
  "description": "A text-first fantasy incremental game about permits, claims and the clerks you teach.",
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && vite --host",
    "build": "npm run content:build && vite build",
    "build:single": "npm run content:build && vite build --mode single",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "content:build": "tsx scripts/build-content.ts",
    "content:validate": "tsx scripts/build-content.ts --check",
    "linecount": "tsx scripts/linecount.ts",
    "sim:smoke": "tsx src/sim/smoke.ts",
    "check": "npm run content:build && npm run typecheck && npm run lint && npm run test && npm run linecount && npm run sim:smoke"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
